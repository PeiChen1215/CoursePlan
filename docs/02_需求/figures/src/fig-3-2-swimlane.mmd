flowchart LR
    subgraph L1["① 课程管理员"]
        direction TB
        A1["维护知识点、先修、资源与参考时长"] --> A2["先修图检查<br/>（成环 / 孤立点）"]
    end

    subgraph L2["② 学生"]
        direction TB
        S1["填写目标、截止日期<br/>可用时间、已掌握"] --> S2["确认计划"]
        S2 --> S3["逐任务打卡"]
    end

    subgraph L3["③ 智能体（大模型）"]
        direction TB
        G1["追问缺失信息"] --> G2["生成冲突说明<br/>与调整建议"]
    end

    subgraph L4["④ 系统（排程与校验引擎）"]
        direction TB
        E5["检测延期 / 目标变更"] --> E1["先修闭包 + 任务分解"]
        E1 --> E2["按可用时段装箱排程"]
        E2 --> E3["四项校验"]
        E3 --> E4["生成计划版本"]
    end

    S1 --> G1
    G1 --> E1
    E3 -->|"存在冲突"| G2
