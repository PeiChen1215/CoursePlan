flowchart TB
    subgraph L1["课程管理员"]
        direction LR
        A1["维护知识点、先修关系<br/>资源与参考时长"]
        A2["先修图检查<br/>（成环 / 孤立点）"]
        A1 --> A2
    end

    subgraph L2["学生"]
        direction LR
        S1["填写目标、截止日期<br/>可用时间、已掌握"]
        S2["确认计划"]
        S3["逐任务打卡<br/>记录实际用时"]
        S1 --> S2 --> S3
    end

    subgraph L3["智能体（大模型）"]
        direction LR
        G1["追问缺失信息<br/>归一化相对日期"]
        G2["生成冲突说明<br/>与调整建议"]
        G1 --> G2
    end

    subgraph L4["系统（排程与校验引擎）"]
        direction LR
        E1["先修闭包 + 任务分解"]
        E2["按可用时段装箱排程"]
        E3["四项校验"]
        E4["生成计划版本"]
        E5["检测延期 / 目标变更"]
        E1 --> E2 --> E3 --> E4
        E5 --> E1
    end

    S1 --> G1
    G1 --> E1
    A1 -.->|"课程内容"| E1
    E3 -->|"存在冲突"| G2
    G2 --> S2
    E4 --> S2
    S3 --> E5
    E5 -->|"触发调整"| E1
