# 复制为 .env 后按需修改；.env 不入库
PROVIDER_MODE=mock            # mock / real / auto
PROVIDER_MODEL=deepseek-flash
PROVIDER_THINKING=disabled   # 分类任务关掉思考，否则 token 会被 reasoning 吃光
PROVIDER_KEY=                 # 只放在本地 .env 或环境变量里
PROVIDER_BASE=https://api.deepseek.com

DB_PATH=data/dev_ui.db
LOG_LEVEL=INFO
